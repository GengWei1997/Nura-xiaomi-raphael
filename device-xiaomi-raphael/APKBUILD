# Reference: <https://postmarketos.org/devicepkg>
maintainer="GengWei1997 <gw19970326@gmail.com>"
pkgname=device-xiaomi-raphael
pkgdesc="Xiaomi Mi 9T Pro / Redmi K20 Pro"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	firmware-xiaomi-raphael
	hexagonrpcd
	linux-xiaomi-raphael
	mkbootimg
	postmarketos-base
	soc-qcom
	soc-qcom-modem
"
makedepends="devicepkg-dev"

# The ALSA files live under ucm2/ here because that is what they are; abuild
# links a local source into $srcdir under its basename, so the names below
# are the names that arrive there.
source="
	81-libssc-xiaomi-raphael.rules
	99-wifi-powersave.conf
	deviceinfo
	50-xiaomi-raphael-fastrpc-suspend.sh
	kernel-cmdline.conf
	modprobe.d-wifi.conf
	modules-initfs
	ucm2/HiFi.conf
	ucm2/raphael.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/81-libssc-xiaomi-raphael.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/

	# Stop the SDSP FastRPC server for suspend; see the script header for
	# why the unit files cannot do this on their own.
	install -Dm755 "$srcdir"/50-xiaomi-raphael-fastrpc-suspend.sh \
		"$pkgdir"/usr/lib/systemd/system-sleep/50-xiaomi-raphael-fastrpc-suspend

	install -Dm644 "$srcdir"/modprobe.d-wifi.conf \
		"$pkgdir"/usr/lib/modprobe.d/wifi.conf

	# NetworkManager's default powersave setting keeps the WLAN receiver
	# asleep between beacons, which on the WCN3990 costs about ten extra
	# milliseconds on most packets.  Override it for this device.
	install -Dm644 "$srcdir"/99-wifi-powersave.conf \
		"$pkgdir"/usr/lib/NetworkManager/conf.d/99-wifi-powersave.conf

	# ALSA use case manager files for the SM8150 sound card.  The verb is
	# named raphael.conf and the conf.d entry points at it, so alsa-lib finds
	# it by the card's driver name (sm8150) and the verb by its own name.
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/raphael/HiFi.conf
	install -Dm644 "$srcdir"/raphael.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/raphael/raphael.conf

	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8150/
	ln -s ../../Qualcomm/raphael/raphael.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8150/sm8150.conf
}

