4a6cc9cdc0bfd0dc2aec5c46fedcf1e3ba6e0b4ed7d35c8b6cb9f4874c480b12cc07bed1bd93362c0f515aa25cd622dc6a15090b1f856510289887fbd698234b  30-initramfs-firmware-xiaomi-raphael.files
"
